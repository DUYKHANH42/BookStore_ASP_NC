@using BookStore.Application.DTO
@using BookStore.Domain.Common
@model PagedResultDTO<StaffUserDTO>
@{
    ViewData["Title"] = "Quản lý nhân sự";
    var search = Context.Request.Query["search"].ToString();
    var role = Context.Request.Query["role"].ToString();
    var isActive = Context.Request.Query["isActive"].ToString();
}

@section Styles {
    <link rel="stylesheet" href="~/admin/css/staff-management.css" />
}

<div class="staff-container space-y-8">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
            <h2 class="text-3xl font-black text-slate-900 tracking-tighter">Quản lý nhân sự</h2>
            <p class="text-slate-500 font-medium">Hệ thống có <span class="text-blue-600 font-bold">@Model.TotalItems</span> tài khoản Admin / Employee.</p>
        </div>
        <button type="button" onclick="openCreateStaffModal()" class="flex items-center gap-3 px-8 py-4 bg-slate-900 text-white rounded-[1.25rem] font-black text-sm shadow-xl shadow-slate-900/20 hover:bg-black transition-premium active:scale-95">
            <span class="material-symbols-outlined">person_add</span> Tạo tài khoản mới
        </button>
    </div>

    <!-- Filters -->
    <div class="glass-card p-8 rounded-[2.5rem] shadow-sm">
        <form method="get" action="@Url.Action("Index")" class="flex flex-wrap gap-4 items-end">
            <div class="flex-1 min-w-[280px] space-y-2">
                <label class="text-[11px] font-black uppercase tracking-widest text-slate-400 px-1">Tìm kiếm</label>
                <div class="relative group">
                    <span class="material-symbols-outlined absolute left-5 top-1/2 -translate-y-1/2 text-slate-400 group-focus-within:text-blue-600 transition-colors">search</span>
                    <input type="text" name="search" value="@search" placeholder="Tên, Email hoặc Số điện thoại..."
                           class="w-full bg-slate-50 border border-slate-100 rounded-2xl pl-14 pr-6 py-4 font-bold text-slate-700 outline-none focus:border-blue-600 focus:bg-white transition-all shadow-sm" />
                </div>
            </div>
            <div class="w-full md:w-52 space-y-2">
                <label class="text-[11px] font-black uppercase tracking-widest text-slate-400 px-1">Vai trò</label>
                <select name="role" class="no-choices w-full bg-slate-50 border border-slate-100 rounded-2xl px-6 py-4 font-bold text-slate-700 outline-none focus:border-blue-600 focus:bg-white transition-all appearance-none shadow-sm cursor-pointer">
                    <option value="">Tất cả vai trò</option>
                    <option value="@UserRoles.Admin" selected="@(role == UserRoles.Admin)">Admin</option>
                    <option value="@UserRoles.Employee" selected="@(role == UserRoles.Employee)">Employee</option>
                </select>
            </div>
            <div class="w-full md:w-52 space-y-2">
                <label class="text-[11px] font-black uppercase tracking-widest text-slate-400 px-1">Trạng thái</label>
                <select name="isActive" class="no-choices w-full bg-slate-50 border border-slate-100 rounded-2xl px-6 py-4 font-bold text-slate-700 outline-none focus:border-blue-600 focus:bg-white transition-all appearance-none shadow-sm cursor-pointer">
                    <option value="">Tất cả</option>
                    <option value="true" selected="@(isActive == "true")">Đang hoạt động</option>
                    <option value="false" selected="@(isActive == "false")">Đã khóa</option>
                </select>
            </div>
            <button type="submit" class="w-14 h-14 flex items-center justify-center rounded-2xl bg-slate-900 text-white hover:bg-black transition-premium shadow-lg shadow-slate-900/20">
                <span class="material-symbols-outlined text-2xl">filter_list</span>
            </button>
        </form>
    </div>

    <!-- Table -->
    <div class="glass-card rounded-[2.5rem] overflow-hidden bg-white premium-shadow">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 w-full">
                <thead>
                    <tr class="bg-slate-50/50">
                        <th class="ps-8 py-6 text-slate-400 font-black text-[10px] uppercase tracking-widest">Nhân sự</th>
                        <th class="text-slate-400 font-black text-[10px] uppercase tracking-widest">Liên hệ</th>
                        <th class="text-slate-400 font-black text-[10px] uppercase tracking-widest">Vai trò</th>
                        <th class="text-slate-400 font-black text-[10px] uppercase tracking-widest">Ngày tạo</th>
                        <th class="text-slate-400 font-black text-[10px] uppercase tracking-widest">Trạng thái</th>
                        <th class="text-end pe-8 text-slate-400 font-black text-[10px] uppercase tracking-widest">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="6" class="px-8 py-16 text-center text-slate-400 font-medium">
                                Không tìm thấy nhân sự nào.
                            </td>
                        </tr>
                    }
                    @foreach (var user in Model.Items)
                    {
                        var isAdmin = user.Role == UserRoles.Admin;
                        <tr class="hover:bg-slate-50/30 transition-colors">
                            <td class="ps-8 py-6">
                                <div class="flex items-center gap-4">
                                    <div class="staff-avatar @(isAdmin ? "role-admin" : "role-employee")">@user.Initials</div>
                                    <div>
                                        <div class="text-slate-900 font-black text-sm">@user.FullName</div>
                                        <div class="text-slate-400 text-xs font-medium">@(string.IsNullOrEmpty(user.Department) ? "—" : user.Department)</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="text-slate-700 font-bold text-sm">@user.Email</div>
                                <div class="text-slate-400 text-xs font-bold">@(user.PhoneNumber ?? "—")</div>
                            </td>
                            <td>
                                <span class="px-3 py-1 rounded-lg font-black text-[10px] uppercase tracking-widest @(isAdmin ? "role-badge-admin" : "role-badge-employee")">@user.Role</span>
                            </td>
                            <td>
                                <div class="text-slate-600 font-bold text-sm">@user.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</div>
                                @if (user.LastLoginAt.HasValue)
                                {
                                    <div class="text-[10px] text-slate-400 font-bold">Login: @user.LastLoginAt.Value.ToLocalTime().ToString("dd/MM HH:mm")</div>
                                }
                            </td>
                            <td>
                                <div class="flex items-center gap-2">
                                    <div class="status-indicator @(user.IsActive ? "status-active" : "status-locked")"></div>
                                    <span class="font-black text-[10px] uppercase tracking-widest @(user.IsActive ? "text-emerald-600" : "text-rose-600")">
                                        @(user.IsActive ? "Active" : "Locked")
                                    </span>
                                </div>
                            </td>
                            <td class="text-end pe-8">
                                <button type="button" data-id="@user.Id" data-active="@user.IsActive.ToString().ToLower()"
                                        class="w-11 h-11 flex items-center justify-center rounded-2xl bg-slate-50 text-slate-400 hover:bg-rose-600 hover:text-white transition-premium btn-toggle-staff-status"
                                        title="@(user.IsActive ? "Khóa tài khoản" : "Mở khóa")">
                                    <span class="material-symbols-outlined text-xl">@(user.IsActive ? "lock" : "lock_open")</span>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="px-8 py-6 bg-slate-50/50 border-t border-slate-100 flex items-center justify-between">
                <p class="text-xs font-black text-slate-400 uppercase tracking-widest">Trang @Model.CurrentPage / @Model.TotalPages</p>
                <div class="flex gap-2">
                    @if (Model.CurrentPage > 1)
                    {
                        <a href="@Url.Action("Index", new { page = Model.CurrentPage - 1, search, role, isActive })" class="w-11 h-11 flex items-center justify-center rounded-2xl bg-white border border-slate-200 text-slate-600 hover:bg-blue-600 hover:text-white transition-premium">
                            <span class="material-symbols-outlined">chevron_left</span>
                        </a>
                    }
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <a href="@Url.Action("Index", new { page = i, search, role, isActive })"
                           class="w-11 h-11 flex items-center justify-center rounded-2xl border font-black text-sm transition-premium @(i == Model.CurrentPage ? "bg-blue-600 border-blue-600 text-white shadow-xl shadow-blue-600/20" : "bg-white border-slate-200 text-slate-600 hover:bg-blue-50")">@i</a>
                    }
                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <a href="@Url.Action("Index", new { page = Model.CurrentPage + 1, search, role, isActive })" class="w-11 h-11 flex items-center justify-center rounded-2xl bg-white border border-slate-200 text-slate-600 hover:bg-blue-600 hover:text-white transition-premium">
                            <span class="material-symbols-outlined">chevron_right</span>
                        </a>
                    }
                </div>
            </div>
        }
    </div>
</div>

<!-- Modal: Tạo tài khoản (bước 1) -->
<div id="createStaffModal" class="modal-overlay modal-lg" onclick="if(event.target === this) closeCreateStaffModal()">
    <div class="modal-content">
        <div class="p-8 md:p-10 space-y-6">
            <div class="flex justify-between items-center">
                <div>
                    <h3 class="text-xl font-black text-slate-900 flex items-center gap-2">
                        <span class="material-symbols-outlined text-blue-600">person_add</span> Tạo tài khoản mới
                    </h3>
                    <p class="text-slate-500 text-sm font-medium mt-1">Admin hoặc Employee — cần xác nhận danh tính ở bước tiếp theo</p>
                </div>
                <button type="button" onclick="closeCreateStaffModal()" class="w-10 h-10 rounded-full flex items-center justify-center bg-slate-50 text-slate-400 hover:bg-slate-900 hover:text-white transition-all">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <form id="createStaffForm" class="space-y-5">
                <div class="space-y-2">
                    <label class="text-[11px] font-black uppercase tracking-widest text-slate-400 px-1">Họ và tên</label>
                    <input type="text" id="staffFullName" required placeholder="Nguyễn Văn A..."
                           class="w-full bg-slate-50 border border-slate-100 rounded-2xl px-6 py-4 font-bold text-slate-700 outline-none focus:border-blue-600 focus:bg-white transition-all" />
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div class="space-y-2">
                        <label class="text-[11px] font-black uppercase tracking-widest text-slate-400 px-1">Email</label>
                        <input type="email" id="staffEmail" required
                               class="w-full bg-slate-50 border border-slate-100 rounded-2xl px-6 py-4 font-bold text-slate-700 outline-none focus:border-blue-600 focus:bg-white transition-all" />
                    </div>
                    <div class="space-y-2">
                        <label class="text-[11px] font-black uppercase tracking-widest text-slate-400 px-1">Số điện thoại</label>
                        <input type="tel" id="staffPhone"
                               class="w-full bg-slate-50 border border-slate-100 rounded-2xl px-6 py-4 font-bold text-slate-700 outline-none focus:border-blue-600 focus:bg-white transition-all" />
                    </div>
                </div>
                <div class="space-y-2">
                    <label class="text-[11px] font-black uppercase tracking-widest text-slate-400 px-1">Phòng ban</label>
                    <input type="text" id="staffDepartment" placeholder="Kho vận, Kinh doanh..."
                           class="w-full bg-slate-50 border border-slate-100 rounded-2xl px-6 py-4 font-bold text-slate-700 outline-none focus:border-blue-600 focus:bg-white transition-all" />
                </div>
                <div class="space-y-3">
                    <label class="text-[11px] font-black uppercase tracking-widest text-slate-400 px-1">Vai trò tài khoản</label>
                    <input type="hidden" id="staffRole" value="@UserRoles.Employee" />
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <button type="button" data-role="@UserRoles.Employee" onclick="selectStaffRole(this)"
                                class="role-picker-card role-picker-active p-5 rounded-2xl border-2 border-slate-100 bg-slate-50 text-left transition-premium hover:border-emerald-300">
                            <div class="flex items-center gap-3 mb-2">
                                <span class="material-symbols-outlined text-emerald-600">badge</span>
                                <span class="font-black text-slate-900 text-sm">Employee</span>
                            </div>
                            <p class="text-[11px] font-bold text-slate-500 leading-relaxed">Nhân viên vận hành — quyền hạn giới hạn theo module được cấp sau.</p>
                        </button>
                        <button type="button" data-role="@UserRoles.Admin" onclick="selectStaffRole(this)"
                                class="role-picker-card p-5 rounded-2xl border-2 border-slate-100 bg-slate-50 text-left transition-premium hover:border-blue-400">
                            <div class="flex items-center gap-3 mb-2">
                                <span class="material-symbols-outlined text-blue-600">admin_panel_settings</span>
                                <span class="font-black text-slate-900 text-sm">Admin</span>
                            </div>
                            <p class="text-[11px] font-bold text-slate-500 leading-relaxed">Quản trị viên — toàn quyền hệ thống, có thể tạo thêm Admin khác.</p>
                        </button>
                    </div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div class="space-y-2">
                        <label class="text-[11px] font-black uppercase tracking-widest text-slate-400 px-1">Mật khẩu</label>
                        <input type="password" id="staffPassword" required minlength="8"
                               class="w-full bg-slate-50 border border-slate-100 rounded-2xl px-6 py-4 font-bold text-slate-700 outline-none focus:border-blue-600 focus:bg-white transition-all" />
                        <p class="text-[10px] font-bold text-slate-400 px-1">Tối thiểu 8 ký tự, có chữ hoa, chữ thường và số (áp dụng cho Admin).</p>
                    </div>
                    <div class="space-y-2">
                        <label class="text-[11px] font-black uppercase tracking-widest text-slate-400 px-1">Xác nhận mật khẩu</label>
                        <input type="password" id="staffConfirmPassword" required minlength="8"
                               class="w-full bg-slate-50 border border-slate-100 rounded-2xl px-6 py-4 font-bold text-slate-700 outline-none focus:border-blue-600 focus:bg-white transition-all" />
                    </div>
                </div>
                <div class="flex gap-4 pt-2">
                    <button type="button" onclick="closeCreateStaffModal()" class="flex-1 py-4 rounded-2xl border border-slate-200 font-black text-[11px] uppercase tracking-widest text-slate-400 hover:bg-slate-50">Hủy</button>
                    <button type="submit" class="flex-1 py-4 rounded-2xl bg-blue-600 text-white font-black text-[11px] uppercase tracking-widest shadow-lg shadow-blue-600/20 hover:bg-blue-700">Tiếp tục xác nhận</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Xác nhận danh tính admin (bước 2) -->
<div id="confirmIdentityModal" class="modal-overlay" onclick="if(event.target === this) closeConfirmIdentityModal()">
    <div class="modal-content">
        <div class="p-8 md:p-10 space-y-6">
            <div class="flex justify-between items-center">
                <div>
                    <h3 class="text-xl font-black text-slate-900 flex items-center gap-2">
                        <span class="material-symbols-outlined text-rose-600">shield</span> Xác nhận danh tính
                    </h3>
                    <p class="text-slate-500 text-sm font-medium mt-1">Nhập mật khẩu admin hiện tại để tạo tài khoản đặc quyền</p>
                </div>
                <button type="button" onclick="closeConfirmIdentityModal()" class="w-10 h-10 rounded-full flex items-center justify-center bg-slate-50 text-slate-400 hover:bg-slate-900 hover:text-white transition-all">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div class="p-5 bg-amber-50 border border-amber-100 rounded-2xl flex items-start gap-3">
                <span class="material-symbols-outlined text-amber-600">info</span>
                <p class="text-xs font-bold text-amber-800 leading-relaxed" id="confirmStaffSummary"></p>
            </div>
            <form id="confirmIdentityForm" class="space-y-5">
                <div class="space-y-2">
                    <label class="text-[11px] font-black uppercase tracking-widest text-slate-400 px-1">Mật khẩu admin của bạn</label>
                    <input type="password" id="adminConfirmPassword" required autocomplete="current-password"
                           class="w-full bg-slate-50 border border-slate-100 rounded-2xl px-6 py-4 font-bold text-slate-700 outline-none focus:border-rose-600 focus:bg-white transition-all" />
                </div>
                <div class="flex gap-4 pt-2">
                    <button type="button" onclick="backToCreateForm()" class="flex-1 py-4 rounded-2xl border border-slate-200 font-black text-[11px] uppercase tracking-widest text-slate-400 hover:bg-slate-50">Quay lại</button>
                    <button type="submit" class="flex-1 py-4 rounded-2xl bg-slate-900 text-white font-black text-[11px] uppercase tracking-widest shadow-lg shadow-slate-900/20 hover:bg-black">Xác nhận & Tạo</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/admin/js/staff-management.js"></script>
}
