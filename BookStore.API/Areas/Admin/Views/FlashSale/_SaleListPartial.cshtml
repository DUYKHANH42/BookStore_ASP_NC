@using BookStore.Application.DTO
@model PagedResultDTO<FlashSaleCampaignDTO>

<div class="table-responsive">
    <table class="w-full text-left border-collapse">
        <thead>
            <tr class="border-b border-slate-50">
                <th class="px-8 py-6 text-[10px] font-black uppercase tracking-widest text-slate-400">Chiến dịch</th>
                <th class="px-8 py-6 text-[10px] font-black uppercase tracking-widest text-slate-400">Quy mô</th>
                <th class="px-8 py-6 text-[10px] font-black uppercase tracking-widest text-slate-400">Thời gian</th>
                <th class="px-8 py-6 text-[10px] font-black uppercase tracking-widest text-slate-400 text-center">Tiến độ bán</th>
                <th class="px-8 py-6 text-[10px] font-black uppercase tracking-widest text-slate-400">Trạng thái</th>
                <th class="px-8 py-6 text-[10px] font-black uppercase tracking-widest text-slate-400 text-right">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Items.Any())
            {
                <tr>
                    <td colspan="6" class="px-8 py-20 text-center">
                        <div class="flex flex-col items-center">
                            <span class="material-symbols-outlined text-5xl text-slate-200 mb-4">campaign</span>
                            <p class="font-bold text-slate-400">Không tìm thấy chiến dịch Flash Sale nào.</p>
                        </div>
                    </td>
                </tr>
            }
            @foreach (var item in Model.Items)
            {
                <tr class="border-b border-slate-50 hover:bg-slate-50/50 transition-colors group @(item.IsActive ? "" : "opacity-50 grayscale-[0.5]")">
                    <td class="px-8 py-6">
                        <p class="font-black text-slate-800 text-sm line-clamp-2">@item.Name</p>
                        <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mt-1">ID: @item.Id</p>
                    </td>
                    <td class="px-8 py-6">
                        <div class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-slate-100 rounded-lg">
                            <span class="material-symbols-outlined text-[14px] text-slate-500">inventory_2</span>
                            <span class="text-xs font-bold text-slate-700">@item.ProductCount sản phẩm</span>
                        </div>
                    </td>
                    <td class="px-8 py-6">
                        <div class="flex items-center gap-2 mb-1">
                            <span class="material-symbols-outlined text-[14px] text-emerald-500">play_circle</span>
                            <span class="text-xs font-bold text-slate-700">@item.StartTime.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-[14px] text-rose-500">stop_circle</span>
                            <span class="text-xs font-bold text-slate-700">@item.EndTime.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                    </td>
                    <td class="px-8 py-6 text-center">
                        <div class="flex flex-col items-center justify-center gap-1">
                            <div class="w-full bg-slate-100 h-1.5 rounded-full overflow-hidden max-w-[80px]">
                                @{
                                    var percent = item.TotalStock > 0 ? (item.TotalSold * 100.0 / item.TotalStock) : 0;
                                }
                                <div class="bg-rose-500 h-full transition-all duration-500" style="width: @(Math.Min(100, percent))%"></div>
                            </div>
                            <span class="font-bold text-slate-700 text-[10px]">@item.TotalSold / @item.TotalStock</span>
                        </div>
                    </td>
                    <td class="px-8 py-6">
                        @if (!item.IsActive)
                        {
                            <span class="px-3 py-1 bg-slate-100 text-slate-600 rounded-lg font-black text-[10px] uppercase tracking-widest inline-flex items-center gap-1.5">
                                <span class="w-1.5 h-1.5 bg-slate-400 rounded-full"></span> Đã tắt
                            </span>
                        }
                        else if (item.Status == "Sắp diễn ra")
                        {
                            <span class="px-3 py-1 bg-blue-50 text-blue-600 rounded-lg font-black text-[10px] uppercase tracking-widest inline-flex items-center gap-1.5">
                                <span class="w-1.5 h-1.5 bg-blue-500 rounded-full animate-pulse"></span> Sắp diễn ra
                            </span>
                        }
                        else if (item.Status == "Đang diễn ra")
                        {
                            <span class="px-3 py-1 bg-rose-50 text-rose-600 rounded-lg font-black text-[10px] uppercase tracking-widest inline-flex items-center gap-1.5">
                                <span class="w-1.5 h-1.5 bg-rose-500 rounded-full animate-pulse"></span> Đang chạy
                            </span>
                        }
                        else
                        {
                            <span class="px-3 py-1 bg-slate-50 text-slate-500 rounded-lg font-black text-[10px] uppercase tracking-widest inline-flex items-center gap-1.5">
                                <span class="w-1.5 h-1.5 bg-slate-400 rounded-full"></span> @item.Status
                            </span>
                        }
                    </td>
                    <td class="px-8 py-6 text-right">
                        <div class="flex items-center justify-end gap-2 opacity-0 group-hover:opacity-100 transition-premium">
                            <button onclick="viewCampaignDetails(@item.Id, '@Html.Raw(item.Name.Replace("'", "\\'"))')" class="w-10 h-10 flex items-center justify-center rounded-xl bg-slate-100 text-blue-600 hover:bg-blue-600 hover:text-white transition-premium" title="Xem chi tiết">
                                <span class="material-symbols-outlined text-lg">visibility</span>
                            </button>
                            <button onclick="openEditCampaignModal(@item.Id)" class="w-10 h-10 flex items-center justify-center rounded-xl bg-slate-100 text-amber-600 hover:bg-amber-600 hover:text-white transition-premium" title="Chỉnh sửa">
                                <span class="material-symbols-outlined text-lg">edit</span>
                            </button>
                            <button onclick="toggleCampaignStatus(@item.Id, this)" 
                                    class="w-10 h-10 flex items-center justify-center rounded-xl bg-slate-100 transition-premium @(item.IsActive ? "text-rose-500 hover:bg-rose-600" : "text-emerald-500 hover:bg-emerald-600") hover:text-white"
                                    title="@(item.IsActive ? "Tắt chương trình" : "Bật chương trình")">
                                <span class="material-symbols-outlined text-lg">@(item.IsActive ? "power_settings_new" : "play_arrow")</span>
                            </button>
                            @if (item.TotalSold == 0)
                            {
                                <button onclick="deleteCampaign(@item.Id)" class="w-10 h-10 flex items-center justify-center rounded-xl bg-slate-100 text-rose-500 hover:bg-rose-600 hover:text-white transition-premium" title="Xóa">
                                    <span class="material-symbols-outlined text-lg">delete</span>
                                </button>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Pagination -->
<div class="px-8 py-6 bg-slate-50/50 flex items-center justify-between border-t border-slate-50">
    <div class="text-[10px] font-black text-slate-400 uppercase tracking-widest">
        Hiển thị @Model.Items.Count() / @Model.TotalItems kết quả
    </div>
    
    <div class="flex items-center gap-1">
        @if (Model.CurrentPage > 1)
        {
            <button data-page="@(Model.CurrentPage - 1)" class="pagination-link w-10 h-10 flex items-center justify-center rounded-xl bg-white border border-slate-200 text-slate-600 hover:border-blue-600 hover:text-blue-600 transition-premium">
                <span class="material-symbols-outlined text-lg">chevron_left</span>
            </button>
        }

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <button data-page="@i" class="pagination-link w-10 h-10 flex items-center justify-center rounded-xl font-bold text-xs @(i == Model.CurrentPage ? "bg-blue-600 text-white shadow-lg shadow-blue-600/20" : "bg-white border border-slate-200 text-slate-600 hover:border-blue-600 hover:text-blue-600") transition-premium">
                @i
            </button>
        }

        @if (Model.CurrentPage < Model.TotalPages)
        {
            <button data-page="@(Model.CurrentPage + 1)" class="pagination-link w-10 h-10 flex items-center justify-center rounded-xl bg-white border border-slate-200 text-slate-600 hover:border-blue-600 hover:text-blue-600 transition-premium">
                <span class="material-symbols-outlined text-lg">chevron_right</span>
            </button>
        }
    </div>
</div>
