@using BookStore.Application.DTO
@model IEnumerable<FlashSaleManagementDTO>

<div class="table-responsive">
    <table class="w-full text-left border-collapse">
        <thead>
            <tr class="border-b border-slate-50">
                <th class="px-4 py-4 text-[10px] font-black uppercase tracking-widest text-slate-400">Hình ảnh</th>
                <th class="px-4 py-4 text-[10px] font-black uppercase tracking-widest text-slate-400">Sản phẩm</th>
                <th class="px-4 py-4 text-[10px] font-black uppercase tracking-widest text-slate-400">Giảm giá</th>
                <th class="px-4 py-4 text-[10px] font-black uppercase tracking-widest text-slate-400 text-center">Tiến độ bán</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="4" class="px-4 py-10 text-center">
                        <p class="font-bold text-slate-400">Không có sản phẩm nào trong chiến dịch này.</p>
                    </td>
                </tr>
            }
            @foreach (var item in Model)
            {
                <tr class="border-b border-slate-50 hover:bg-slate-50/50 transition-colors">
                    <td class="px-4 py-4">
                        <div class="w-12 h-16 rounded overflow-hidden shadow border border-slate-100 flex items-center justify-center bg-white">
                            <img src="@((item.ImageUrl ?? "").StartsWith("http") ? item.ImageUrl : "/uploads/" + item.ImageUrl)" 
                                 class="w-full h-full object-cover" />
                        </div>
                    </td>
                    <td class="px-4 py-4">
                        <p class="font-black text-slate-800 text-sm line-clamp-2 max-w-[200px]">@item.ProductName</p>
                        <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mt-1">ID: @item.ProductId</p>
                    </td>
                    <td class="px-4 py-4">
                        <div class="space-y-0.5">
                            <p class="font-black text-slate-900">@item.SalePrice.ToString("N0") <span class="text-[10px]">₫</span></p>
                            <p class="text-[10px] text-rose-500 font-bold line-through opacity-60">@item.OriginalPrice.ToString("N0") ₫</p>
                        </div>
                    </td>
                    <td class="px-4 py-4 text-center">
                        <div class="flex flex-col items-center justify-center gap-1">
                            <div class="w-full bg-slate-100 h-1.5 rounded-full overflow-hidden max-w-[80px]">
                                @{
                                    var percent = item.SaleStock > 0 ? (item.SoldCount * 100.0 / item.SaleStock) : 0;
                                }
                                <div class="bg-rose-500 h-full transition-all duration-500" style="width: @(Math.Min(100, percent))%"></div>
                            </div>
                            <span class="font-bold text-slate-700 text-[10px]">@item.SoldCount / @item.SaleStock</span>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
